{
  "name": "ManualProcedureCount",
  "type": "object",
  "properties": {
    "intern_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05ea\u05de\u05d7\u05d4"
    },
    "intern_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05ea\u05de\u05d7\u05d4"
    },
    "procedure_category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05e4\u05e8\u05d5\u05e6\u05d3\u05d5\u05e8\u05d4"
    },
    "procedure_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e4\u05e8\u05d5\u05e6\u05d3\u05d5\u05e8\u05d4"
    },
    "manual_count": {
      "type": "number",
      "default": 0,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d1\u05d9\u05e6\u05d5\u05e2\u05d9\u05dd \u05d9\u05d3\u05e0\u05d9\u05d9\u05dd (\u05dc\u05dc\u05d0 \u05de\u05e9\u05d5\u05d1)"
    }
  },
  "required": [
    "intern_id",
    "procedure_category",
    "procedure_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.intern_id": "{{user.intern_entity_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.intern_id": "{{user.intern_entity_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}