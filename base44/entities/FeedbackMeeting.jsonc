{
  "name": "FeedbackMeeting",
  "type": "object",
  "properties": {
    "intern_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05ea\u05de\u05d7\u05d4"
    },
    "intern_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05ea\u05de\u05d7\u05d4"
    },
    "meeting_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4"
    },
    "invited_experts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "description": "\u05de\u05d5\u05de\u05d7\u05d9\u05dd \u05de\u05d5\u05d6\u05de\u05e0\u05d9\u05dd"
    },
    "location": {
      "type": "string",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u05de\u05ea\u05d5\u05db\u05e0\u05df",
        "\u05d4\u05ea\u05e7\u05d9\u05d9\u05dd",
        "\u05d1\u05d5\u05d8\u05dc"
      ],
      "default": "\u05de\u05ea\u05d5\u05db\u05e0\u05df",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4"
    },
    "reminder_sent_2days": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e0\u05e9\u05dc\u05d7\u05d4 \u05ea\u05d6\u05db\u05d5\u05e8\u05ea \u05d9\u05d5\u05de\u05d9\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9"
    },
    "reminder_sent_morning": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e0\u05e9\u05dc\u05d7\u05d4 \u05ea\u05d6\u05db\u05d5\u05e8\u05ea \u05d1\u05d1\u05d5\u05e7\u05e8 \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4"
    }
  },
  "required": [
    "intern_id",
    "intern_name",
    "meeting_date"
  ]
}