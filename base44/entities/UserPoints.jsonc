{
  "name": "UserPoints",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 (User entity id)"
    },
    "user_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "user_role": {
      "type": "string",
      "enum": [
        "intern",
        "expert"
      ],
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3"
    },
    "total_points": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05da \u05d4\u05e0\u05e7\u05d5\u05d3\u05d5\u05ea"
    },
    "weekly_record": {
      "type": "number",
      "default": 0,
      "description": "\u05e9\u05d9\u05d0 \u05d1\u05e7\u05e9\u05d5\u05ea \u05de\u05e9\u05d5\u05d1 \u05e9\u05d1\u05d5\u05e2\u05d9 (\u05dc\u05de\u05ea\u05de\u05d7\u05d9\u05dd)"
    }
  },
  "required": [
    "user_id",
    "user_role"
  ]
}