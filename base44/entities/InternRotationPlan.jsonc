{
  "name": "InternRotationPlan",
  "type": "object",
  "properties": {
    "intern_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05ea\u05de\u05d7\u05d4"
    },
    "intern_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05ea\u05de\u05d7\u05d4"
    },
    "department": {
      "type": "string",
      "enum": [
        "\u05d2\u05e0\u05d9\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4",
        "\u05de\u05d9\u05d9\u05dc\u05d3\u05d5\u05ea",
        "\u05e4\u05d5\u05e8\u05d9\u05d5\u05ea",
        "\u05d0\u05d5\u05e0\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4",
        "\u05db\u05dc\u05dc\u05d9"
      ],
      "description": "\u05de\u05d7\u05dc\u05e7\u05d4"
    },
    "stage_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e9\u05dc\u05d1 / \u05d4\u05e1\u05d1\u05d1"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d7\u05dc\u05d4"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd"
    },
    "is_current": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d6\u05d4 \u05d4\u05e9\u05dc\u05d1 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9"
    },
    "meeting_opening_done": {
      "type": "boolean",
      "default": false,
      "description": "\u05e9\u05d9\u05d7\u05ea \u05e4\u05ea\u05d9\u05d7\u05d4 \u05d1\u05d5\u05e6\u05e2\u05d4"
    },
    "meeting_opening_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e9\u05d9\u05d7\u05ea \u05e4\u05ea\u05d9\u05d7\u05d4"
    },
    "meeting_middle_done": {
      "type": "boolean",
      "default": false,
      "description": "\u05e9\u05d9\u05d7\u05ea \u05d0\u05de\u05e6\u05e2 \u05d1\u05d5\u05e6\u05e2\u05d4"
    },
    "meeting_middle_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e9\u05d9\u05d7\u05ea \u05d0\u05de\u05e6\u05e2"
    },
    "meeting_closing_done": {
      "type": "boolean",
      "default": false,
      "description": "\u05e9\u05d9\u05d7\u05ea \u05e1\u05d9\u05db\u05d5\u05dd \u05d1\u05d5\u05e6\u05e2\u05d4"
    },
    "meeting_closing_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e9\u05d9\u05d7\u05ea \u05e1\u05d9\u05db\u05d5\u05dd"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "intern_id",
    "department",
    "start_date",
    "end_date"
  ]
}