{
  "name": "MeetingSummary",
  "type": "object",
  "properties": {
    "intern_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05ea\u05de\u05d7\u05d4"
    },
    "intern_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05ea\u05de\u05d7\u05d4"
    },
    "meeting_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4"
    },
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea / \u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4"
    },
    "file_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e7\u05d5\u05d1\u05e5 \u05e9\u05d4\u05d5\u05e2\u05dc\u05d4"
    },
    "file_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05d5\u05d1\u05e5 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea"
    },
    "bucket": {
      "type": "string",
      "enum": [
        "meeting_summary",
        "professional",
        "misc"
      ],
      "default": "misc",
      "description": "\u05e1\u05dc \u05d4\u05e1\u05d9\u05d5\u05d5\u05d2 \u05e9\u05dc \u05d4\u05de\u05e1\u05de\u05da"
    }
  },
  "required": [
    "intern_id",
    "intern_name",
    "meeting_date"
  ]
}