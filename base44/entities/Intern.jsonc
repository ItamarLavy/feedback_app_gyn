{
  "name": "Intern",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05ea\u05de\u05d7\u05d4"
    },
    "email": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05de\u05d9\u05d9\u05dc \u05e8\u05d0\u05e9\u05d9\u05ea"
    },
    "email2": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05de\u05d9\u05d9\u05dc \u05e0\u05d5\u05e1\u05e4\u05ea (\u05e9\u05e0\u05d9\u05d9\u05d4)"
    },
    "password": {
      "type": "string",
      "description": "\u05e1\u05d9\u05e1\u05de\u05d4 \u05d0\u05d9\u05e9\u05d9\u05ea"
    },
    "nickname": {
      "type": "string",
      "description": "\u05db\u05d9\u05e0\u05d5\u05d9 \u05e9\u05e0\u05d1\u05d7\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05de\u05ea\u05de\u05d7\u05d4"
    },
    "avatar": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05d4\u05d3\u05de\u05d5\u05ea \u05e9\u05e0\u05d1\u05d7\u05e8\u05d4"
    },
    "stage": {
      "type": "string",
      "enum": [
        "\u05ea\u05d5\u05e8\u05df 4",
        "\u05ea\u05d5\u05e8\u05df 3",
        "\u05ea\u05d5\u05e8\u05df 2",
        "\u05ea\u05d5\u05e8\u05df 1 \u05e6\u05e2\u05d9\u05e8",
        "\u05ea\u05d5\u05e8\u05df 1 \u05de\u05ea\u05e7\u05d3\u05dd"
      ],
      "description": "\u05e9\u05dc\u05d1 \u05d1\u05ea\u05db\u05e0\u05d9\u05ea \u05d4\u05d4\u05ea\u05de\u05d7\u05d5\u05ea (\u05e8\u05de\u05ea \u05e1\u05de\u05db\u05d5\u05ea)"
    },
    "stage_start_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05e9\u05dc\u05d1 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9"
    },
    "rotation": {
      "type": "string",
      "enum": [
        "\u05d2\u05d9\u05e0\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4",
        "\u05de\u05d9\u05d9\u05dc\u05d3\u05d5\u05ea",
        "\u05e4\u05d5\u05e8\u05d9\u05d5\u05ea",
        "\u05d0\u05d5\u05e0\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4",
        "\u05de\u05d9\u05d5\u05df",
        "\u05e8\u05d5\u05d8\u05e6\u05d9\u05d4 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea"
      ],
      "description": "\u05d4\u05e8\u05d5\u05d8\u05e6\u05d9\u05d4 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05ea\u05de\u05d7\u05d4"
    },
    "birthday": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05d5\u05dd \u05d4\u05d5\u05dc\u05d3\u05ea"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "data.email2": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "data.email2": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}