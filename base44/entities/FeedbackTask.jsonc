{
  "name": "FeedbackTask",
  "type": "object",
  "properties": {
    "expert_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d1\u05db\u05d9\u05e8 \u05e9\u05e9\u05dc\u05d7 \u05d0\u05ea \u05d4\u05d1\u05e7\u05e9\u05d4"
    },
    "expert_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d1\u05db\u05d9\u05e8"
    },
    "intern_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05ea\u05de\u05d7\u05d4"
    },
    "intern_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05ea\u05de\u05d7\u05d4"
    },
    "intern_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05ea\u05de\u05d7\u05d4 \u05dc\u05e6\u05d5\u05e8\u05da \u05e9\u05dc\u05d9\u05d7\u05ea \u05d4\u05ea\u05e8\u05d0\u05d4"
    },
    "procedure_category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05e4\u05e8\u05d5\u05e6\u05d3\u05d5\u05e8\u05d4"
    },
    "procedure_type": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e4\u05e8\u05d5\u05e6\u05d3\u05d5\u05e8\u05d4"
    },
    "procedure_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e4\u05e8\u05d5\u05e6\u05d3\u05d5\u05e8\u05d4"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05d7\u05d5\u05e4\u05e9\u05d9\u05d5\u05ea \u05de\u05d4\u05d1\u05db\u05d9\u05e8 (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d1\u05e7\u05e9\u05d4"
    },
    "feedback_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05d5\u05d1 \u05e9\u05e0\u05d5\u05e6\u05e8 \u05d1\u05e2\u05e7\u05d1\u05d5\u05ea \u05d4\u05d1\u05e7\u05e9\u05d4"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d1\u05d9\u05e6\u05d5\u05e2"
    }
  },
  "required": [
    "expert_id",
    "intern_id",
    "procedure_category",
    "procedure_type",
    "procedure_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.expert_id": "{{user.expert_entity_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.expert_id": "{{user.expert_entity_id}}"
        },
        {
          "data.intern_id": "{{user.intern_entity_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.expert_id": "{{user.expert_entity_id}}"
        },
        {
          "data.intern_id": "{{user.intern_entity_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.expert_id": "{{user.expert_entity_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}