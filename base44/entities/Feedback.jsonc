{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "procedure_id_code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05d6\u05d9\u05d4\u05d5\u05d9 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e9\u05dc \u05d4\u05e4\u05e8\u05d5\u05e6\u05d3\u05d5\u05e8\u05d4 (\u05dc\u05d3\u05d5\u05d2\u05de\u05d4: #001)"
    },
    "intern_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05ea\u05de\u05d7\u05d4"
    },
    "intern_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05ea\u05de\u05d7\u05d4"
    },
    "expert_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d5\u05de\u05d7\u05d4"
    },
    "expert_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05de\u05d7\u05d4"
    },
    "procedure_category": {
      "type": "string",
      "enum": [
        "OB",
        "GYN",
        "IVF",
        "ONCO",
        "\u05db\u05dc\u05dc\u05d9"
      ],
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05e4\u05e8\u05d5\u05e6\u05d3\u05d5\u05e8\u05d4"
    },
    "procedure_type": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e4\u05e8\u05d5\u05e6\u05d3\u05d5\u05e8\u05d4"
    },
    "form_type": {
      "type": "string",
      "enum": [
        "procedural",
        "clinical_management",
        "ward_management",
        "teaching_research",
        "communication"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d8\u05d5\u05e4\u05e1 \u05dc\u05e4\u05d9 GynStones CBD"
    },
    "procedure_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d1\u05d9\u05e6\u05d5\u05e2 \u05d4\u05e4\u05e8\u05d5\u05e6\u05d3\u05d5\u05e8\u05d4"
    },
    "intern_verbal_feedback": {
      "type": "string",
      "description": "\u05de\u05e9\u05d5\u05d1 \u05de\u05d9\u05dc\u05d5\u05dc\u05d9 \u05e2\u05e6\u05de\u05d9 \u05e9\u05dc \u05d4\u05de\u05ea\u05de\u05d7\u05d4"
    },
    "intern_submitted_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e9\u05dc\u05d9\u05d7\u05ea \u05d4\u05de\u05e9\u05d5\u05d1 \u05d4\u05e2\u05e6\u05de\u05d9"
    },
    "expert_overall_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "\u05d4\u05e2\u05e8\u05db\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea / \u05d4\u05e2\u05e8\u05db\u05ea \u05e4\u05e2\u05d5\u05dc\u05d4 - \u05de\u05d5\u05de\u05d7\u05d4 (1-5)"
    },
    "expert_knowledge_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05d9\u05d3\u05e2 - \u05de\u05d5\u05de\u05d7\u05d4"
    },
    "expert_clinical_skill_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05ea \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea / \u05e0\u05d9\u05d4\u05d5\u05dc \u05e2\u05d1\u05d5\u05d3\u05ea \u05e6\u05d5\u05d5\u05ea - \u05de\u05d5\u05de\u05d7\u05d4"
    },
    "expert_communication_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d1\u05d9\u05df \u05d0\u05d9\u05e9\u05d9\u05ea - \u05de\u05d5\u05de\u05d7\u05d4"
    },
    "expert_independence": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05ea\u05de\u05d7\u05d4 \u05de\u05e1\u05d5\u05d2\u05dc \u05dc\u05d1\u05e6\u05e2 \u05d1\u05d0\u05d5\u05e4\u05df \u05e2\u05e6\u05de\u05d0\u05d9?"
    },
    "expert_professionalism_concern": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d9\u05e9 \u05d7\u05e9\u05e9 \u05dc\u05d2\u05d1\u05d9 \u05de\u05e7\u05e6\u05d5\u05e2\u05d9\u05d5\u05ea?"
    },
    "expert_professionalism_details": {
      "type": "string",
      "description": "\u05e4\u05e8\u05d8\u05d9 \u05d7\u05e9\u05e9 \u05de\u05e7\u05e6\u05d5\u05e2\u05d9\u05d5\u05ea"
    },
    "expert_verbal_feedback": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea / \u05de\u05e9\u05d5\u05d1 \u05de\u05d9\u05dc\u05d5\u05dc\u05d9 \u05e9\u05dc \u05d4\u05de\u05d5\u05de\u05d7\u05d4"
    },
    "expert_submitted_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e9\u05dc\u05d9\u05d7\u05ea \u05de\u05e9\u05d5\u05d1 \u05d4\u05de\u05d5\u05de\u05d7\u05d4"
    },
    "intern_overall_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "\u05d4\u05e2\u05e8\u05db\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e2\u05e6\u05de\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05ea\u05de\u05d7\u05d4"
    },
    "intern_knowledge_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05d9\u05d3\u05e2 - \u05e2\u05e6\u05de\u05d9"
    },
    "intern_clinical_skill_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05ea \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea - \u05e2\u05e6\u05de\u05d9"
    },
    "intern_communication_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05ea\u05e7\u05e9\u05d5\u05e8\u05ea - \u05e2\u05e6\u05de\u05d9"
    },
    "intern_independence": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05ea\u05de\u05d7\u05d4 \u05d7\u05d5\u05e9\u05d1 \u05e9\u05de\u05e1\u05d5\u05d2\u05dc \u05dc\u05d1\u05e6\u05e2 \u05d1\u05d0\u05d5\u05e4\u05df \u05e2\u05e6\u05de\u05d0\u05d9?"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_expert_review",
        "completed"
      ],
      "default": "pending_expert_review",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05de\u05e9\u05d5\u05d1"
    }
  },
  "required": [
    "intern_id",
    "expert_id",
    "procedure_category",
    "procedure_type"
  ]
}